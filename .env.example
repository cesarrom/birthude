# Database (Vercel Postgres or Self-hosted)
# For Docker Compose: postgres://birthude:birthude@db:5432/birthude
# For external DB: postgres://user:password@host:5432/db
POSTGRES_URL="postgres://birthude:birthude@db:5432/birthude"

# Docker Compose Database Credentials (only used in docker-compose.yml)
POSTGRES_USER="birthude"
POSTGRES_PASSWORD="birthude"
POSTGRES_DB="birthude"

# NextAuth - Must be set to your deployed domain for production
# For Dokploy: https://your-domain.com
# For local Docker: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-a-random-string"
# Set to your actual domain to prevent UntrustedHost errors
# For production: birthude.askn.us (no https:// prefix)
AUTH_TRUSTED_HOSTS="localhost:3000,birthude.askn.us"

# OpenRouter AI
OPENROUTER_API_KEY="sk-or-..."

# Geoapify Geocoding
GEOAPIFY_API_KEY="your-geoapify-key"

# Contento (self-hosted file management, Bytescale replacement)
# Example: https://contento.yourdomain.com
CONTENTO_BASE_URL="http://localhost:3001"
# Get these from Contento Admin UI -> Project settings
CONTENTO_PROJECT_ID="proj_..."
CONTENTO_PROJECT_SLUG="my-app"
# API key must include at least: write
CONTENTO_API_KEY="cnt_..."

# Bytescale
BYTESCALE_ACCOUNT_ID="acc_..."
BYTESCALE_API_KEY="bsk_..."

# dLocal Go Payment API
# Get these from your dLocal Go Dashboard -> Integrations -> API Integration
# Sandbox dashboard: https://dashboard-sbx.dlocalgo.com/
# Live dashboard: https://dashboard.dlocalgo.com/
DLOCAL_GO_API_KEY="your-api-key"
DLOCAL_GO_SECRET_KEY="your-secret-key"
DLOCAL_GO_ENV="sandbox" # or "live"